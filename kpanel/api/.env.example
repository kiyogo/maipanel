# Local API using PostgreSQL exposed by kpanel/docker-compose.yml.
# The database password below matches the existing development-only Compose setup.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kpanel
DB_PASSWORD=kpanel123
DB_NAME=kpanel
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=3001
# Optional. Leave empty to use the built-in rule-based AI fallback.
GEMINI_API_KEY=
